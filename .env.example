# DriftGuard Environment Configuration Template
# Copy this file to .env before running services locally or via Docker.

APP_ENV=development
LOG_LEVEL=INFO

# FastAPI Inference Service
# Use 127.0.0.1 for local development; Docker Compose overrides this to 0.0.0.0 inside containers.
API_HOST=127.0.0.1
API_PORT=8000
ENABLE_SHAP=true
SHAP_TOP_K=3

# MLflow Tracking & Model Registry
# Locally, sqlite:///mlflow.db stores metadata in the repo root; Docker Compose points to http://mlflow:5000.
# Note: MlflowClient.set_registered_model_alias uses the bare alias name ("champion"), while URIs use "@champion".
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=driftguard-fraud-detection
MLFLOW_MODEL_NAME=driftguard-xgb-fraud
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_CHALLENGER_ALIAS=challenger

# Prediction Audit Database
# Uses SQLite by default. To switch to PostgreSQL, install psycopg[binary] and set:
# postgresql+psycopg://user:password@host:5432/driftguard
DATABASE_URL=sqlite:///./data/predictions.db

# Data & Drift Monitoring
REFERENCE_DATA_PATH=data/reference/reference.parquet
# Fraction of monitored features that must drift before triggering an automated retrain (e.g., 0.25 = 25%).
DRIFT_SHARE_THRESHOLD=0.25
# Minimum PR-AUC score required on holdout data before promoting a challenger model to @champion.
DRIFT_MIN_PR_AUC=0.75
